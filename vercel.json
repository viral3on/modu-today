{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash -c 'b=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$b^{commit}\" 2>/dev/null && git diff --quiet \"$b\" \"${VERCEL_GIT_COMMIT_SHA:-HEAD}\" -- . \":(exclude)docs/**\" \":(exclude)tests/**\" \":(exclude).github/**\" \":(exclude)*.md\"'"
}
